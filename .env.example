APP_NAME=SnipURL
APP_VERSION=0.1.0
ENVIRONMENT=development

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042

REDIS_HOST=localhost
REDIS_PORT=6379

PUBLIC_BASE_URL=http://localhost:8000
ADMIN_API_KEY=change-me
CACHE_TTL_SECONDS=3600
CREATE_RATE_LIMIT=30
REDIRECT_RATE_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
MAX_PAGE_SIZE=100
GENERATED_CODE_RETRIES=5

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLICK_TOPIC=snipurl.clicks
KAFKA_CONSUMER_GROUP=snipurl-analytics
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_MAX_RANGE_DAYS=366

STARTUP_ATTEMPTS=20
STARTUP_DELAY_SECONDS=2
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_EPOCH_MS=1767225600000
SNOWFLAKE_MAX_CLOCK_ROLLBACK_MS=5
